# ============================================================
# law-study-workbench — 公开仓库忽略规则
# 严禁将真实用户数据 / 版权材料 / 密钥提交到公开仓库
# ============================================================

# ---- 用户学习数据（严禁进入公开仓库）----
data/
*.db
*.sqlite
*.sqlite3
secrets/
private/

# 用户教材 PDF 与商业版权材料
*.pdf

# SQLite 伴生文件（WAL/SHM/journal 含完整数据，须一并忽略）
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# StudyPack / StudyEvents 学习活动数据
StudyPack*.json
StudyEvents*.json

# 本地备份 / 交接材料 / 归档
*.zip
*.bak
*.backup
*handoff*
backups/
rollback-*/

# 产物与截图（公开仓库不保存，除非逐项验证为合成且必要）
artifacts/

# ---- 密钥与 API Key ----
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
api-keys/
credentials/

# ---- 依赖与构建产物 ----
node_modules/
.venv/
venv/
__pycache__/
.pytest_cache/
*.pyc
dist/
build/
.cache/

# ---- 本机临时目录与缓存 ----
tmp/
temp/
*.log
*.tmp

# ---- 编辑器 / 系统文件 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---- 本机工具目录 ----
.reasonix/
